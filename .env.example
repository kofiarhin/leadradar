# LeadRadar server configuration.
# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# Public origin of the application. Supplies the trusted-origin allowlist
# used to reject cross-site state-changing requests.
APP_URL=http://localhost:5173

# MongoDB Atlas (or any MongoDB) connection string.
MONGODB_URI=mongodb://localhost:27017/leadradar

# Session signing secret. Use a long random value; minimum 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seeded owner account. Read only by `npm run seed`, never at runtime.
# Seeding is idempotent and will not overwrite an already-changed password.
ADMIN_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password

# Public LinkedIn comment discovery through Apify. Actor selection stays configurable.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# NVIDIA NIM/OpenAI-compatible model used for structured AI tasks.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Hunter V2 API for enrichment, reviewed campaign sequences and reply integration.
HUNTER_API_KEY=
# Hunter connected sender account used only for explicit human-reviewed one-off replies.
HUNTER_EMAIL_ACCOUNT_ID=
# Shared secret protecting the public Hunter webhook URL. Use a random 32+ character value.
# Configure Hunter's message.replied webhook target as:
# https://<app-host>/api/v1/webhooks/hunter?token=<HUNTER_WEBHOOK_SECRET>
HUNTER_WEBHOOK_SECRET=

# Safety default. Keep disabled unless live outbound has been separately authorized.
OUTBOUND_MODE=disabled
