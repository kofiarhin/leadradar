# LeadRadar server configuration.
# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# Public origin of the application. Supplies the trusted-origin allowlist
# used to reject cross-site state-changing requests.
APP_URL=http://localhost:5173

# MongoDB Atlas (or any MongoDB) connection string.
MONGODB_URI=mongodb://localhost:27017/leadradar

# Session signing secret. Use a long random value; minimum 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seeded owner account. Read only by `npm run seed`, never at runtime.
# Seeding is idempotent and will not overwrite an already-changed password.
ADMIN_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
